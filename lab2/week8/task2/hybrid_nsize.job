#!/bin/bash
#SBATCH --job-name=hybrid_nsize
#SBATCH --time=00:10:00
#SBATCH --mem=16G
#SBATCH --nodes=1
#SBATCH --ntasks=4
#SBATCH --cpus-per-task=4
#SBATCH --partition=defq

# Problem-size sweep at 16 cores on one node. The spec asks for at least 30
# values of n, and every speedup needs a serial time measured at that same n,
# on the same hardware.
#
# Two modes, chosen by the allocation shape (the CAAS template allocates a
# hybrid job as tasks x cpus-per-task, and an MPI job as tasks x 1, so the
# MPI and hybrid runs cannot share a job):
#
#   4 tasks x 4 cpus  (default) : serial, OpenMP 16 threads, hybrid 4x4
#   16 tasks x 1 cpu            : MPI 16 processes only
#
# Serial time grows as roughly 46 s * (n / 10^8)^1.5, so the 30 values are
# split into five submissions of about 7 minutes each:
#
#   sbatch --export=ALL,NLIST="10000000 15000000 20000000 25000000 30000000 35000000 40000000 45000000 50000000 55000000" hybrid_nsize.job
#   sbatch --export=ALL,NLIST="60000000 65000000 70000000 75000000 80000000 85000000 90000000" hybrid_nsize.job
#   sbatch --export=ALL,NLIST="95000000 100000000 105000000 110000000 115000000 120000000" hybrid_nsize.job
#   sbatch --export=ALL,NLIST="125000000 130000000 135000000 140000000" hybrid_nsize.job
#   sbatch --export=ALL,NLIST="145000000 150000000 155000000" hybrid_nsize.job
#
# The MPI runs are fast, so all 30 values fit in one submission:
#
#   sbatch --ntasks=16 --cpus-per-task=1 --export=ALL,NLIST="10000000 15000000 20000000 25000000 30000000 35000000 40000000 45000000 50000000 55000000 60000000 65000000 70000000 75000000 80000000 85000000 90000000 95000000 100000000 105000000 110000000 115000000 120000000 125000000 130000000 135000000 140000000 145000000 150000000 155000000" hybrid_nsize.job
#
# Serial runs once per n (its spread on CAAS was 0.1-0.5%); the parallel
# versions run REPS times since they are cheap and noisier. Runs under ~1 s at
# the small n end are noisy -- say so on the slide rather than hiding them.
#
# Threads are not pinned; see hybrid_bindcheck.job.

module load openmpi/4.1.5-gcc-11.2.0-ux65npg

export OMP_NUM_THREADS=$SLURM_CPUS_PER_TASK

REPS=2
P=$SLURM_NTASKS
T=$SLURM_CPUS_PER_TASK

if [ -z "$NLIST" ]; then
    echo "Set NLIST, e.g. sbatch --export=ALL,NLIST=\"10000000 20000000\" hybrid_nsize.job"
    exit 1
fi

if [ "$T" -eq 1 ]; then
    MODE=mpi
else
    MODE=hybrid
fi

echo "Problem-size sweep ($MODE mode): n=[$NLIST] reps=$REPS shape=${P}x${T}"
echo "Node: $(hostname)"
echo

for N in $NLIST; do
    if [ $MODE = mpi ]; then
        for REP in $(seq 1 $REPS); do
            echo "--- n=$N mpi $P rep=$REP ---"
            srun --ntasks=$P ./task1_mpi $N 1
        done
        continue
    fi

    echo "--- n=$N serial ---"
    ./task1 $N

    for REP in $(seq 1 $REPS); do
        # OpenMP runs in the batch step itself, which owns all P*T cores.
        echo "--- n=$N openmp $((P * T)) rep=$REP ---"
        ./task3 $N $((P * T))

        echo "--- n=$N hybrid ${P}x${T} rep=$REP ---"
        srun --ntasks=$P --cpus-per-task=$T ./task2_hybrid $N $T 1
    done
done

echo
echo "Problem-size sweep complete."
