#!/bin/bash
#SBATCH --job-name=sweep_2node32
#SBATCH --time=00:09:00
#SBATCH --mem=16G
#SBATCH --ntasks=32
#SBATCH --cpus-per-task=1
#SBATCH --ntasks-per-node=16
#SBATCH --partition=defq

# Maximum scale: 32 processes, the cluster limit, filling two nodes.
#
# This is where efficiency should be at its worst -- the search time per rank
# is smallest here, so fixed costs (startup, collectives, imbalance) make up
# the largest fraction of runtime. Expect the speedup curve to bend away from
# linear most visibly at this point.
#
# Nodes are shared with research clusters, so 32-process runs are the most
# exposed to other users' load. Five repeats and a median matter most here.
#
# Submit with: sbatch sweep_2node32.job

module load openmpi/4.1.5-gcc-11.2.0-ux65npg

N=100000000
REPS=5

echo "Two-node run: n=$N ntasks=32 (16 per node) reps=$REPS"
echo

for SCHEME in 0 1 2; do
    for REP in $(seq 1 $REPS); do
        echo "--- scheme=$SCHEME rep=$REP ---"
        srun ./task1_mpi $N $SCHEME
    done
done

echo
echo "32-process run complete."
